# Next.js only reads env files from its own project root (this directory),
# not the repo root .env — copy this to .env.local for local dev.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Shows the Orientation Calibration admin panel — leave unset/false in
# normal use; calibration is complete and this only toggles the panel.
NEXT_PUBLIC_ENABLE_ORIENTATION_CALIBRATION=false
