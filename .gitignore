# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*
.eslintcache
# TypeScript incremental build cache — generated, machine-specific.
*.tsbuildinfo

# --- Env files ---
.env
.env.local
.env.*.local

# --- Database ---
*.sqlite3
postgres_data/

# --- AI / Vector store / model artifacts ---
# data/chroma_db/ IS committed: Railway builds the backend image from the
# GitHub context, so the existing `gat_kb` vector collection (~23 MB, 1507
# documents) must be in Git to be baked into the image. It is never rebuilt
# or re-embedded. The broad *.sqlite3 rule above is re-negated for this one
# file so ChromaDB's metadata store is tracked with the rest of the dir.
!data/chroma_db/chroma.sqlite3
*.pt
*.pth
# Exception: the trained intent-classifier weights (75 KB) are a committed
# deliverable — the production/Railway image needs them at import time
# (backend/app/intent_model/classify.py) and they are not regenerable
# without the full training-data pipeline.
!backend/app/intent_model/artifacts/intent_lstm.pt

# --- Knowledge base raw data acquisition (scripts/ai/) — large, and
# regeneratable from the official sources via the collector scripts.
# data/processed/ (chunks.jsonl) and data/metadata/ (source_manifest.json)
# are kept tracked: small, and the auditable proof of where knowledge
# came from. ---
data/raw/
data/logs/

# --- Generated tour panoramas (regenerate via scripts/media/build_panoramas.py
# from the real source photos; too large to track in git) ---
frontend/public/panoramas/main-building/

# --- Docker / logs ---
*.log

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
*.bak

# --- Local Claude Code tooling (personal settings, installed skills,
# ad-hoc verification screenshots) — not project deliverables ---
.claude/
screenshots/
