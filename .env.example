# ============================================================
# General
# ============================================================
ENVIRONMENT=development

# ============================================================
# Frontend (Next.js)
# Note: Next.js only reads env files from its own project root.
# For local (non-Docker) dev, also copy these into frontend/.env.local
# ============================================================
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Shows the Orientation Calibration admin panel on the Virtual Tour page.
# Calibration is otherwise complete and read-only — leave unset/false in
# normal use; the save endpoint and persistence stay fully functional
# either way, this only toggles the panel's visibility.
NEXT_PUBLIC_ENABLE_ORIENTATION_CALIBRATION=false
# Shows the Cross-Floor Hotspot placement admin panel (click a spot on the
# panorama, pick a destination scene, save a visual sightline hotspot).
# Leave unset/false in normal use.
NEXT_PUBLIC_ENABLE_CROSS_FLOOR_PLACEMENT=false
# Phase 17 — powers the satellite view of /map (frontend/src/features/mapSatellite/).
# Get a key from https://console.cloud.google.com/google/maps-apis, with the
# "Maps JavaScript API" enabled, restricted to your dev/prod origins. Never
# commit a real key — leave blank in .env.example, set it only in
# frontend/.env.local (gitignored) or your deployment platform's secrets.
# Without a key, /map's satellite view shows a graceful "unavailable" state
# and the rest of the app (including the 3D view toggle) still works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================
# Backend (FastAPI)
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# ============================================================
# Database (PostgreSQL)
# ============================================================
POSTGRES_USER=gat_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gat_campus_tour
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://gat_admin:change-me@db:5432/gat_campus_tour

# ============================================================
# AI / LangChain / ChromaDB / Ollama
# ============================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=gat_kb
